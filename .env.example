# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database / Redis
DB_ENGINE=django.db.backends.sqlite3
SQLITE_PATH=db.sqlite3
REDIS_URL=redis://localhost:6379/0

# Browser ingestion
CELERY_TIMEZONE=Asia/Tehran
DIVAR_REQUEST_INTERVAL_SECONDS=2.5
DIVAR_REQUIRE_AUTHENTICATED_SESSION=False

# GapGPT advertiser classification
GAPGPT_API_KEY=replace-with-your-gapgpt-api-key
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-5.6-luna
GAPGPT_TIMEOUT_SECONDS=30

# Local browser security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
AUTH_COOKIE_SECURE=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
