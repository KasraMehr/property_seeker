
# ------------------------------------------------------------
# LOCAL DEVELOPMENT
# ------------------------------------------------------------
# settings.py no longer reads DJANGO_ENV (it switches on DEBUG /
# DB_ENGINE instead), so this line is just documentation for
# whoever reads the file next — safe to keep or delete.
DJANGO_ENV=local

# Dev-only key. settings.py already falls back to a clearly-fake
# key if this is unset, so this line is optional — kept explicit
# here for clarity. Never reuse this value anywhere else.
SECRET_KEY=django-insecure-local-key
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.sqlite3
SQLITE_PATH=db.sqlite3

REDIS_URL=redis://localhost:6379/0

CELERY_TIMEZONE=Asia/Tehran
DIVAR_REQUEST_INTERVAL_SECONDS=2.5

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
AUTH_COOKIE_SECURE=False

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
